  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "记账本",
    "navigationBarBackgroundColor": "#1AA86C",
    "backgroundColor": "#F8F8F8",
    "app-plus": {
      "bounce": "none"
